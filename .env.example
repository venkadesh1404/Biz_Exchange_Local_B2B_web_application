# ============================================================
# BIZ EXCHANGE — Environment Configuration
# Copy this file to ".env" and configure as needed.
# ============================================================

# Base URL of your Java Spring Boot REST API.
# When set, the frontend will call the real API endpoints.
# When unset (or empty), the frontend uses the built-in mock
# data service (localStorage-backed) for development and demos.
#
# Example: VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=

# Set to "true" to force mock mode even if VITE_API_BASE_URL is set.
# Useful for testing or demos without the backend running.
# VITE_FORCE_MOCK=false
